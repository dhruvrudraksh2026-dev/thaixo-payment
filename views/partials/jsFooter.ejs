<!-- Sidebar Admin Panel Logo Changes -->
<script>
    const desktopLogo = "/assets/images/logo/ThaiXoAdminLogo.png";
    const mobileLogo = "/assets/images/logo/ThaiXo_Favicon.png";

    const desktopWidth = "180px";
    const mobileWidth = "47px";

    function updateLogo()
    {
        if ($(window).width() < 768)
        {
            // On mobile, sidebar is off-canvas so show full logo but slightly smaller to avoid overflow
            $(".app-logo .logo img").attr("style", `width: ${mobileWidth} !important`);
            $(".app-logo .logo img").attr("src", desktopLogo);
        }
        if ($("nav").hasClass("semi-nav"))
        {
            if ($(window).width() < 768)
            {
                // Collapsed sidebar
                $(".app-logo .logo img").attr("style", `width: ${desktopWidth} !important`);
                $(".app-logo .logo img").attr("src", desktopLogo);
            } else
            {
                // Collapsed sidebar
                $(".app-logo .logo img").attr("style", `width: ${mobileWidth} !important`);
                $(".app-logo .logo img").attr("src", mobileLogo);
            }
        } else
        {
            // Full sidebar
            $(".app-logo .logo img").attr("style", `width: ${desktopWidth} !important`);
            $(".app-logo .logo img").attr("src", desktopLogo);
        }
    }

    // On page load
    $(function ()
    {
        updateLogo();
    });

    // Sync when toggled
    $(document).on('click', '.header-toggle', function ()
    {
        // Wait briefly for semi-nav class to be toggled by other scripts, then update
        setTimeout(updateLogo, 10);
    });

    // Keep hover effect for desktop
    $("nav").on("mouseenter", function ()
    {
        if ($(this).hasClass("semi-nav") && $(window).width() >= 768)
        {
            $(".app-logo .logo img").attr("style", `width: ${desktopWidth} !important`);
            $(".app-logo .logo img").attr("src", desktopLogo);
        }
    });

    $("nav").on("mouseleave", function ()
    {
        if ($(this).hasClass("semi-nav") && $(window).width() >= 768)
        {
            $(".app-logo .logo img").attr("style", `width: ${mobileWidth} !important`);
            $(".app-logo .logo img").attr("src", mobileLogo);
        }
    });

    // Sync on window resize since script.js alters semi-nav class dynamically
    $(window).on('resize', function ()
    {
        setTimeout(updateLogo, 10);
    });
</script>

