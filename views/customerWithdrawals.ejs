<!DOCTYPE html>
<html lang="en">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Multipurpose, super flexible, powerful, clean modern responsive bootstrap 5 admin template"
        name="description">
    <meta
        content="admin template, ki-admin admin template, dashboard template, flat admin template, responsive admin template, web app"
        name="keywords">
    <meta content="la-themes" name="author">

    <title>Customer Withdrawals</title>

    <%- include('partials/cssHeader') %>
</head>

<body>
    <div class="app-wrapper">

        <div class="loader-wrapper">
            <div class="loader_24"></div>
        </div>

        <!-- Menu Navigation starts -->
        <%- include('partials/sidebar') %>
            <!-- Menu Navigation ends -->

            <div class="app-content">
                <div class="">
                    <!-- Header Section starts -->
                    <%- include('partials/header') %>

                        <main class="page-wrapper compact-wrapper" id="pageWrapper">


                            <div class="page-body-wrapper">


                                <div class="page-body">

                                    <div class="container-fluid">
                                        <div class="row page-title">
                                            <div class="col-sm-6">
                                                <h3>Pending Customer Withdrawals</h3>
                                            </div>
                                            <!-- <div class="col-sm-6">
                                                <nav>
                                                    <ol class="breadcrumb justify-content-sm-end align-items-center">
                                                        <li class="breadcrumb-item">
                                                            <a href="/">
                                                                <svg class="svg-color">
                                                                    <use href="/assets/svg/iconly-sprite.svg#Home">
                                                                    </use>
                                                                </svg>
                                                            </a>
                                                        </li>
                                                        <li class="breadcrumb-item">Masters</li>
                                                        <li class="breadcrumb-item active">Girls Package</li>
                                                    </ol>
                                                </nav>
                                            </div> -->
                                        </div>
                                    </div>

                                    <div class="container-fluid">
                                        <div class="row">
                                            <div class="col">
                                                <div id="customer-earning-details"
                                                    class="customer-earning-details card text-start shadow-sm d-flex justify-content-between align-items-center flex-row"
                                                    style="padding: 10px;">
                                                    <div class="totalPendingWithdrawalsBlock">
                                                        <div id="totalPendingWithdrawalsAmount"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-sm-12">

                                                <div class="card">
                                                    <div
                                                        class="card-header pb-2 card-no-border d-flex justify-content-between align-items-center">
                                                        <div class="">
                                                            <button class="btn btn-primary" data-bs-toggle="modal"
                                                                data-bs-target="#addModal">
                                                                Add
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div class="card-body">
                                                        <div class="table-responsive">
                                                            <table class="display app-data-table default-data-table"
                                                                id="customer-withdrawals-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Withdrawal Id</th>
                                                                        <th>Customer Id</th>
                                                                        <th>Withdrawal Method</th>
                                                                        <th>Withdrawal Amount</th>
                                                                        <th>Payout Details</th>
                                                                        <th>Status</th>
                                                                        <th>Created At</th>
                                                                        <th>Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="customer-withdrawals-table-body"></tbody>
                                                            </table>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </main>

                        <div class="modal fade bd-example-modal-lg" id="addModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary-900">
                                        <h5 class="modal-title text-white">Add Customer Withdrawal</h5>
                                        <button class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body dark-modal">
                                        <form id="addCustomerWithdrawalForm" class="row g-3 custom-input">
                                            <div class="col-12">
                                                <label class="form-label" for="addCustomerId">Customer Id *</label>
                                                <input type="number" id="addCustomerId" name="customerId"
                                                    class="form-control" placeholder="Customer Id" required>
                                            </div>

                                            <div class="col-6">
                                                <label class="form-label" for="addWithdrawalMethod">Withdrawal Method
                                                    *</label>
                                                <input type="text" id="addWithdrawalMethod" name="withdrawalMethod"
                                                    class="form-control" placeholder="Withdrawal Method" required>
                                            </div>

                                            <div class="col-6">
                                                <label class="form-label" for="addWithdrawalAmount">Withdrawal Amount
                                                    *</label>
                                                <input type="number" id="addWithdrawalAmount" name="withdrawalAmount"
                                                    class="form-control" placeholder="Withdrawal Amount" min="1"
                                                    required>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Withdrawal Details
                                                    *</label>
                                                <textarea id="addPayoutDetails" name="payoutDetails"
                                                    class="form-control withdrawal-details" style="height: 450px;"
                                                    required></textarea>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label fw-semibold" for="addStatus">
                                                    Status <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select shadow-sm" name="status" id="addStatus"
                                                    required>
                                                    <option selected disabled>Select Payment Status</option>
                                                    <option value="PENDING">🟡 Pending</option>
                                                    <option value="DONE">🟢 Done</option>
                                                    <option value="CANCELLED">🔴 Cancelled</option>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <button class="btn btn-primary" type="submit">Add</button>
                                            </div>

                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="modal fade bd-example-modal-lg" id="editModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">

                                    <div class="modal-header bg-primary-900">
                                        <h5 class="modal-title text-white">Edit Customer Withdrawal</h5>
                                        <button class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body dark-modal">

                                        <form id="editCustomerWithdrawalForm" class="row g-3 custom-input">
                                            <input type="hidden" id="editId" name="id">
                                            <input type="hidden" id="editCustomerId" name="customerId">

                                            <div class="col-12">
                                                <label class="form-label">Withdrawal Method *</label>
                                                <input type="text" id="editWithdrawalMethod" name="withdrawalMethod"
                                                    class="form-control" required>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Withdrawal Amount *</label>
                                                <input type="number" id="editWithdrawalAmount" name="withdrawalAmount"
                                                    class="form-control" min="1" required>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Withdrawal Details *</label>
                                                <textarea id="editPayoutDetails" name="payoutDetails"
                                                    class="form-control withdrawal-details" style="height: 450px;"
                                                    required></textarea>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label fw-semibold" for="editStatus">
                                                    Status <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select shadow-sm" name="status" id="editStatus"
                                                    required>
                                                    <option selected disabled>Select Payment Status</option>
                                                    <option value="PENDING">🟡 Pending</option>
                                                    <option value="DONE">🟢 Done</option>
                                                    <option value="CANCELLED">🔴 Cancelled</option>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <button class="btn btn-primary" type="submit">Edit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>
    </div>

    <%- include('partials/modals') %>

        <%- include('partials/jsFooter') %>
            <script src="/js/init/customerWithdrawalsInit.js" type="module"></script>
</body>

</html>