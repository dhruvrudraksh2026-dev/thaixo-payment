<!DOCTYPE html>
<html lang="en">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Multipurpose, super flexible, powerful, clean modern responsive bootstrap 5 admin template"
        name="description">
    <meta
        content="admin template, ki-admin admin template, dashboard template, flat admin template, responsive admin template, web app"
        name="keywords">
    <meta content="la-themes" name="author">

    <title>Customer Withdrawals</title>

    <%- include('partials/cssHeader') %>
        <!-- Data Table css-->
        <link href="/assets/vendor/datatable/jquery.dataTables.min.css" rel="stylesheet" type="text/css">

        <!-- Buttons extension CSS -->
        <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

        <style>
            input[type="checkbox"].row-checkbox,
            input[type="checkbox"]#select-all {
                appearance: none;
                -webkit-appearance: none;
                width: 24px;
                height: 24px;
                margin-left: 5px;
                cursor: pointer;
                background-color: #fff;
                border: 2px solid #cbd5e1;
                border-radius: 6px;
                display: inline-block;
                position: relative;
                transition: all 0.2s ease;
            }

            /* Hover state */
            input[type="checkbox"].row-checkbox:hover,
            input[type="checkbox"]#select-all:hover {
                border-color: #3b82f6;
                background-color: #eff6ff;
            }

            /* Checked state background */
            input[type="checkbox"].row-checkbox:checked,
            input[type="checkbox"]#select-all:checked {
                background-color: #3b82f6;
                border-color: #3b82f6;
            }

            /* The checkmark icon (drawn using a pseudo-element) */
            input[type="checkbox"].row-checkbox:checked::after,
            input[type="checkbox"]#select-all::after {
                content: '';
                position: absolute;
                left: 7px;
                top: 3px;
                width: 6px;
                height: 11px;
                border: solid white;
                border-width: 0 3px 3px 0;
                transform: rotate(45deg);
            }

            .dt-buttons .dt-button {
                margin: 13px;
                padding: 12px;
                font-size: 14px !important;
                border-radius: 6px !important;
                font-weight: 600 !important;
                color: #fff !important;
                background-color: rgb(15 98 106) !important;
            }
        </style>
</head>

<body>
    <div class="app-wrapper">

        <div class="loader-wrapper">
            <div class="loader_24"></div>
        </div>

        <!-- Menu Navigation starts -->
        <%- include('partials/sidebar') %>
            <!-- Menu Navigation ends -->

            <div class="app-content">
                <div class="">
                    <!-- Header Section starts -->
                    <%- include('partials/header') %>

                        <main class="page-wrapper compact-wrapper" id="pageWrapper">


                            <div class="page-body-wrapper">


                                <div class="page-body">

                                    <div class="container-fluid">
                                        <div class="row page-title">
                                            <div class="col-sm-6">
                                                <h3>All Customer Withdrawals</h3>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="container-fluid">
                                        <div class="row">
                                            <div class="col">
                                                <div id="customer-earning-details"
                                                    class="customer-earning-details card text-start shadow-sm d-flex justify-content-between align-items-center flex-row"
                                                    style="padding: 10px;">
                                                    <div class="totalAllWithdrawalsBlock">
                                                        <div id="totalAllWithdrawalsAmount"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-sm-12">
                                                <div class="card" id="date-range-card">
                                                    <div class="card-body">
                                                        <form id="dateRangeForm" class="row g-3 align-items-end">
                                                            <div class="col-md-3">
                                                                <label for="startDate" class="form-label">Start
                                                                    Date</label>
                                                                <input type="date" class="form-control" id="startDate"
                                                                    name="startDate" required>
                                                            </div>

                                                            <div class="col-md-3">
                                                                <label for="endDate" class="form-label">End
                                                                    Date</label>
                                                                <input type="date" class="form-control" id="endDate"
                                                                    name="endDate" required>
                                                            </div>

                                                            <div class="col-md-3">
                                                                <button type="submit"
                                                                    class="btn btn-primary fs-6 fw-semibold w-100 d-flex align-items-center justify-content-center">
                                                                    <i class="ti ti-adjustments fs-5 me-2"></i>
                                                                    <span>Apply Filter</span>
                                                                </button>
                                                            </div>

                                                            <div class="col-md-3">
                                                                <button type="reset"
                                                                    class="btn btn-warning fs-6 fw-semibold w-100 d-flex align-items-center justify-content-center"
                                                                    id="resetFilterBtn">
                                                                    <i class="ti ti-reload fs-5 me-2"></i>
                                                                    <span>Reset Filter</span>
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                                <div class="card">
                                                    <div
                                                        class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center">
                                                        <h4 class="card-title">Customer Withdrawals List</h4>
                                                        <div class="card-action">
                                                            <button class="btn btn-primary btn-sm" id="edit-withdrawals"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editWithdrawalsStatusModal" disabled>
                                                                Edit Withdrawals
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="app-datatable-default overflow-auto">
                                                            <table
                                                                class="display app-data-table default-data-table table"
                                                                id="customer-withdrawals-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>
                                                                            <div
                                                                                class="d-flex align-items-center justify-content-center gap-2">
                                                                                <input type="checkbox" id="select-all"
                                                                                    class="cursor-pointer">
                                                                                <label for="select-all"
                                                                                    class="mb-0">Select
                                                                                    All</label>
                                                                            </div>
                                                                        </th>
                                                                        <th>Withdrawal Id</th>
                                                                        <th>Customer</th>
                                                                        <th>Method</th>
                                                                        <th>Amount</th>
                                                                        <th>Payout Details</th>
                                                                        <th>Status</th>
                                                                        <th>Created At</th>
                                                                        <th>Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="customer-withdrawals-table-body"></tbody>
                                                                <tfoot>
                                                                    <tr>
                                                                        <th></th>
                                                                        <th></th>
                                                                        <th></th>
                                                                        <th class="text-center fs-5">Total:
                                                                        </th>
                                                                        <th class="text-start fs-5">0.00
                                                                        </th>
                                                                        <th></th>
                                                                        <th></th>
                                                                        <th></th>
                                                                        <th></th>
                                                                    </tr>
                                                                </tfoot>
                                                            </table>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </main>

                        <!-- Edit Withdrawal Modal -->
                        <div class="modal fade bd-example-modal-lg" id="editModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">

                                    <div class="modal-header bg-primary-900">
                                        <h5 class="modal-title text-white">Edit Customer Withdrawal</h5>
                                        <button class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body dark-modal">

                                        <form id="editCustomerWithdrawalForm" class="row g-3 custom-input">
                                            <input type="hidden" id="editWithdrawalId" name="id">
                                            <input type="hidden" id="editWithdrawalCustomerId" name="customerId">

                                            <div class="col-12">
                                                <label class="form-label">Withdrawal Method *</label>
                                                <select id="editMethod" name="method" class="form-select" required>
                                                    <option disabled selected>Select Withdrawal Method</option>
                                                    <option value="Bank">Bank</option>
                                                    <option value="Via Agency">Via Agency</option>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Withdrawal Amount *</label>
                                                <input type="number" id="editWithdrawalAmount" name="withdrawalAmount"
                                                    class="form-control" min="1" required>
                                            </div>

                                            <div class="col-12">
                                                <label for="kv-edit-container" class="form-label">Withdrawal Details
                                                    *</label>
                                                <div id="kv-edit-container">
                                                </div>

                                                <button type="button" id="addEditRow"
                                                    class="btn btn-outline-primary btn-sm py-1"
                                                    data-target="#kv-edit-container">
                                                    <i class="ti ti-plus fs-5"></i>
                                                </button>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label fw-semibold" for="editWithdrawalStatus">
                                                    Status <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select shadow-sm" name="status"
                                                    id="editWithdrawalStatus" required>
                                                    <option selected disabled>Select Payment Status</option>
                                                    <option value="PENDING">🟡 Pending</option>
                                                    <option value="DONE">🟢 Done</option>
                                                    <option value="CANCELLED">🔴 Cancelled</option>
                                                </select>
                                            </div>

                                            <div class="col-12 d-none" id="editCancelNoteContainer">
                                                <label class="form-label fw-semibold" for="editCancelNote">
                                                    Cancel Note <span class="text-danger">*</span>
                                                </label>
                                                <textarea class="form-control shadow-sm" name="note" id="editCancelNote"
                                                    rows="3" placeholder="Enter reason for cancellation..."></textarea>
                                            </div>

                                            <div class="col-12">
                                                <button class="btn btn-primary" type="submit">Edit</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Edit Withdrawals Status Modal -->
                        <div class="modal fade" id="editWithdrawalsStatusModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog modal-md shadow-lg">
                                <div class="modal-content border-0">

                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title text-white">
                                            <i class="ti ti-settings fs-4 me-2"></i>Update Withdrawal Status
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body py-4">
                                        <form id="updateStatusForm" class="custom-input">
                                            <div class="mb-4">
                                                <label class="form-label fs-6 text-dark mb-2"
                                                    for="editWithdrawalsStatus">
                                                    Select New Status <span class="text-danger">*</span>
                                                </label>

                                                <select
                                                    class="form-select form-select-lg shadow-sm border-primary-subtle"
                                                    name="status" id="editWithdrawalsStatus" required>
                                                    <option value="" selected disabled>Choose status...</option>
                                                    <option value="PENDING">🟡 Pending</option>
                                                    <option value="DONE">🟢 Done</option>
                                                    <option value="CANCELLED">🔴 Cancelled</option>
                                                </select>
                                            </div>

                                            <div class="mb-4 d-none" id="editBulkCancelNoteContainer">
                                                <label class="form-label fs-6 text-dark mb-2" for="editBulkCancelNote">
                                                    Cancel Note <span class="text-danger">*</span>
                                                </label>
                                                <textarea
                                                    class="form-control form-control-lg shadow-sm border-primary-subtle"
                                                    name="note" id="editBulkCancelNote" rows="3"
                                                    placeholder="Enter reason for cancellation..."></textarea>
                                            </div>

                                            <div class="d-grid">
                                                <button class="btn btn-primary btn-lg shadow" type="submit"
                                                    id="updateStatusBtn">
                                                    Update
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>
    </div>

    <%- include('partials/modals') %>
        <%- include('partials/jsFooter') %>
            <!-- data table js -->
            <script src="/assets/vendor/datatable/jquery.dataTables.min.js"></script>

            <!-- Buttons extension JS -->
            <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

            <!-- Buttons HTML5 export -->
            <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

            <!-- JSZip for Excel export -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

            <!-- For PDF Option -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

            <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
            <!-- For PDF Option -->

            <script src="/js/init/customerWithdrawalsInit.js" type="module"></script>
</body>

</html>