<!DOCTYPE html>
<html lang="en">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Multipurpose, super flexible, powerful, clean modern responsive bootstrap 5 admin template"
        name="description">
    <meta
        content="admin template, ki-admin admin template, dashboard template, flat admin template, responsive admin template, web app"
        name="keywords">
    <meta content="la-themes" name="author">

    <title>Customer Transactions</title>

    <%- include('partials/cssHeader') %>

</head>

<body>
    <div class="app-wrapper">

        <div class="loader-wrapper">
            <div class="loader_24"></div>
        </div>

        <%- include('partials/sidebar') %>

            <div class="app-content">
                <div class="">
                    <%- include('partials/header') %>

                        <main>
                            <div class="page-body">
                                <div class="container-fluid">
                                    <div class="row page-title">
                                        <div class="col-sm-6">
                                            <h3>About User Transactions</h3>
                                        </div>
                                    </div>
                                    <div class="row page-title">
                                        <div class="col">
                                            <ol class="breadcrumb">
                                                <li class="breadcrumb-item"><a href="/thai-customers">Thai Customers</a>
                                                </li>
                                                <li class="breadcrumb-item active" aria-current="page">Customer
                                                    Transactions</li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>
                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div class="card-header pb-0 card-no-border">
                                                    <h4>User Info</h4>
                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="customer-details" style="padding: 10px;"></div>
                                                    <div id="customer-earning-details"
                                                        class="customer-earning-details card text-start shadow-sm m-2"
                                                        style="padding: 10px;">
                                                        <div class="totalEarningsBlock">
                                                            <div id="totalEarningsAmount"></div>
                                                        </div>
                                                        <div class="totalPaidAmountBlock">
                                                            <div id="totalPaidAmount"></div>
                                                        </div>
                                                    </div>
                                                    <div
                                                        class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                                        <div id="generate-secure-otp"
                                                            class="generate-secure-otp d-flex align-items-center justify-content-start gap-3 p-2 flex-wrap">
                                                        </div>
                                                        <div class="d-flex align-items-end gap-3 flex-wrap p-2">
                                                            <h1 class="fs-5">Toggle White Listed</h1>
                                                            <div id="toggle-white-listed"
                                                                class="toggle-white-listed d-flex align-items-center justify-content-start gap-3 p-2 flex-wrap">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Customer Transactions Info -->
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div
                                                    class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center">
                                                    <h4>Customer Earnings Info</h4>
                                                </div>

                                                <div class="card-body p-0">
                                                    <div id="totalEarningsByDateRage"
                                                        class="card text-center shadow-sm p-2 m-2">
                                                        <!-- <div
                                                            class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center mb-4">
                                                            <h4>Total Earnings By Date Range</h4>
                                                        </div> -->
                                                        <div class="card-body">
                                                            <form id="dateRangeForm" class="row g-3 align-items-end">
                                                                <div class="col-md-3">
                                                                    <label for="startDate" class="form-label">Start
                                                                        Date</label>
                                                                    <input type="date" class="form-control"
                                                                        id="startDate" name="startDate" required>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <label for="endDate" class="form-label">End
                                                                        Date</label>
                                                                    <input type="date" class="form-control" id="endDate"
                                                                        name="endDate" required>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <button type="submit"
                                                                        class="btn btn-primary fs-6 fw-semibold w-100 d-flex align-items-center justify-content-center">
                                                                        <i class="ti ti-adjustments fs-5 me-2"></i>
                                                                        <span>Apply Filter</span>
                                                                    </button>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <button type="reset"
                                                                        class="btn btn-warning fs-6 fw-semibold w-100 d-flex align-items-center justify-content-center"
                                                                        id="resetFilterBtn">
                                                                        <i class="ti ti-reload fs-5 me-2"></i>
                                                                        <span>Reset Filter</span>
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    <hr class="divider" />
                                                    <div class="app-datatable-default overflow-auto">
                                                        <table class="display app-data-table default-data-table table"
                                                            id="customer-transactions-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>#</th>
                                                                    <th>Package Name</th>
                                                                    <th>Minutes</th>
                                                                    <th>Rate Per Minute</th>
                                                                    <th>Earnings</th>
                                                                    <th>Time</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="customer-transactions-table-body"></tbody>
                                                        </table>
                                                    </div>
                                                    <hr class="divider" />
                                                    <div class="text-start p-2 m-2">
                                                        <div id="dateRangeEarningsResult"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Customer Withdrawal Info -->
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div
                                                    class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center mb-4">
                                                    <h4>Customer Withdrawal Info</h4>
                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="app-datatable-default overflow-auto">
                                                        <table class="display app-data-table default-data-table table"
                                                            id="customer-withdrawals-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Withdrawal Id</th>
                                                                    <th>Customer Id</th>
                                                                    <th>Withdrawal Method</th>
                                                                    <th>Withdrawal Amount</th>
                                                                    <th>Payout Details</th>
                                                                    <th>Status</th>
                                                                    <th>Created At</th>
                                                                    <th>Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="customer-withdrawals-table-body"></tbody>
                                                        </table>
                                                    </div>
                                                    <hr class="divider" />
                                                    <div class="text-start p-2 m-2">
                                                        <div id="dateRangeWithdrawalResult"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </main>
                        <div class="go-top">
                            <span class="progress-value">
                                <i class="ti ti-arrow-up"></i>
                            </span>
                        </div>
                </div>
            </div>
    </div>

    <!-- Add Modal -->
    <div class="modal fade bd-example-modal-lg" id="addModal" tabindex="-1" role="dialog"
        aria-labelledby="myExtraLargeModal" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary-900">
                    <h5 class="modal-title text-white" id="addModalLabel">Add Transaction</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body dark-modal">
                    <div class="large-modal-header">
                    </div>
                    <div class="large-modal-body d-block">
                        <form class="stepper-one row g-3 custom-input" id="addForm" enctype="multipart/form-data">
                            <input type="text" id="addPackageId" name="packageId" hidden />
                            <input id="addCustomerId" name="customerId" type="text" hidden />

                            <div class="col-12">
                                <label class="col-sm-12 form-label" for="addAmount">Amount<span
                                        class="text-danger">*</span></label>
                                <input class="form-control" id="addAmount" name="amount" type="number"
                                    placeholder="Enter Amount To Be Paid" step="0.01" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold" for="addStatus">
                                    Status <span class="text-danger">*</span>
                                </label>

                                <select class="form-select shadow-sm" name="status" id="addStatus" required>
                                    <option selected disabled>Select Payment Status</option>
                                    <option value="PENDING">🟡 Pending</option>
                                    <option value="DONE">🟢 Done</option>
                                    <option value="CANCELLED">🔴 Cancelled</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <button class="btn btn-light-primary" type="submit" id="addSubmit">Add</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade bd-example-modal-lg" id="editModal" tabindex="-1" role="dialog"
        aria-labelledby="myExtraLargeModal" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary-900">
                    <h5 class="modal-title text-white" id="editModalLabel">Edit Transaction</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body dark-modal">
                    <div class="large-modal-header">
                    </div>
                    <div class="large-modal-body d-block">
                        <form class="stepper-one row g-3 custom-input" id="editForm" enctype="multipart/form-data">
                            <input type="text" id="editPackageId" name="packageId" hidden />
                            <input id="editCustomerId" name="customerId" type="text" hidden />
                            <input id="editCreatedAt" name="createdAt" type="text" hidden />
                            <input id="editIndex" name="index" type="text" hidden />
                            <input id="editRate" name="rate" type="text" hidden />
                            <input id="editMinutes" name="minutes" type="text" hidden />

                            <div class="col-12">
                                <label class="col-sm-12 form-label" for="editAmount">Amount<span
                                        class="text-danger">*</span></label>
                                <input class="form-control" id="editAmount" name="amount" type="number"
                                    placeholder="Enter Amount To Be Paid" step="0.01" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold" for="editStatus">
                                    Status <span class="text-danger">*</span>
                                </label>

                                <select class="form-select shadow-sm" name="status" id="editStatus" required>
                                    <option selected disabled>Select Payment Status</option>
                                    <option value="PENDING">🟡 Pending</option>
                                    <option value="DONE">🟢 Done</option>
                                    <option value="CANCELLED">🔴 Cancelled</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <button class="btn btn-light-primary" type="submit" id="editSubmit">Edit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/modals') %>

        <script src="/assets/js/jquery-3.6.3.min.js"></script>

        <script src="/assets/vendor/simplebar/simplebar.js"></script>

        <script src="/assets/vendor/phosphor/phosphor.js"></script>

        <script src="/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>

        <script src="/assets/vendor/prism/prism.min.js"></script>
        <script src="/assets/vendor/datatable/jquery.dataTables.min.js"></script>

        <script src="/assets/js/script.js"></script>

        <script src="/js/init/customerTransactionsInit.js" type="module"></script>
        <script src="/js/utils/jsCookie.js"></script>
        <script src="/js/utils/helper.js" type="module"></script>
</body>

</html>