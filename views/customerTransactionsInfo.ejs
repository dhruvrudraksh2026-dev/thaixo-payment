<!DOCTYPE html>
<html lang="en">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Multipurpose, super flexible, powerful, clean modern responsive bootstrap 5 admin template"
        name="description">
    <meta
        content="admin template, ki-admin admin template, dashboard template, flat admin template, responsive admin template, web app"
        name="keywords">
    <meta content="la-themes" name="author">

    <title>Customer Transactions</title>

    <%- include('partials/cssHeader') %>

</head>

<body>
    <div class="app-wrapper">

        <div class="loader-wrapper">
            <div class="loader_24"></div>
        </div>

        <%- include('partials/sidebar') %>

            <div class="app-content">
                <div class="">
                    <%- include('partials/header') %>

                        <main>
                            <div class="page-body">
                                <div class="container-fluid">
                                    <div class="row page-title">
                                        <div class="col-sm-6">
                                            <h3>About User Transactions</h3>
                                        </div>
                                    </div>
                                    <div class="row page-title" id="breadcrumbs-section">

                                    </div>
                                </div>
                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div class="card-header pb-0 card-no-border">
                                                    <h4>User Info</h4>
                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="customer-details" style="padding: 10px;"></div>
                                                    <div id="customer-earning-details"
                                                        class="customer-earning-details card text-start shadow-sm m-2 d-flex justify-content-between align-items-center flex-row"
                                                        style="padding: 10px;">
                                                        <div class="totalEarningsBlock">
                                                            <div id="totalEarningsAmount"></div>
                                                        </div>
                                                        <div class="totalPaidAmountBlock">
                                                            <div id="totalPaidAmount"></div>
                                                        </div>
                                                        <div class="totalPendingAmountBlock">
                                                            <div id="totalPendingAmount"></div>
                                                        </div>
                                                    </div>
                                                    <div
                                                        class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                                        <div id="generate-secure-otp"
                                                            class="generate-secure-otp d-flex align-items-center justify-content-start gap-3 p-2 flex-wrap">
                                                        </div>
                                                        <div class="d-flex align-items-end gap-3 flex-wrap p-2">
                                                            <h1 class="fs-5">Toggle White Listed</h1>
                                                            <div id="toggle-white-listed"
                                                                class="toggle-white-listed d-flex align-items-center justify-content-start gap-3 p-2 flex-wrap">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Customer Transactions Info -->
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div
                                                    class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center">
                                                    <h4>Customer Earnings Info</h4>
                                                </div>

                                                <div class="card-body p-0">
                                                    <div id="totalEarningsByDateRage"
                                                        class="card text-center shadow-sm p-2 m-2">
                                                        <!-- <div
                                                            class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center mb-4">
                                                            <h4>Total Earnings By Date Range</h4>
                                                        </div> -->
                                                        <div class="card-body">
                                                            <form id="dateRangeForm" class="row g-3 align-items-end">
                                                                <div class="col-md-3">
                                                                    <label for="startDate" class="form-label">Start
                                                                        Date</label>
                                                                    <input type="date" class="form-control"
                                                                        id="startDate" name="startDate" required>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <label for="endDate" class="form-label">End
                                                                        Date</label>
                                                                    <input type="date" class="form-control" id="endDate"
                                                                        name="endDate" required>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <button type="submit"
                                                                        class="btn btn-primary fs-6 fw-semibold w-100 d-flex align-items-center justify-content-center">
                                                                        <i class="ti ti-adjustments fs-5 me-2"></i>
                                                                        <span>Apply Filter</span>
                                                                    </button>
                                                                </div>

                                                                <div class="col-md-3">
                                                                    <button type="reset"
                                                                        class="btn btn-warning fs-6 fw-semibold w-100 d-flex align-items-center justify-content-center"
                                                                        id="resetFilterBtn">
                                                                        <i class="ti ti-reload fs-5 me-2"></i>
                                                                        <span>Reset Filter</span>
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    <hr class="divider" />
                                                    <div class="app-datatable-default overflow-auto">
                                                        <table class="display app-data-table default-data-table table"
                                                            id="customer-transactions-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>#</th>
                                                                    <th>Package Name</th>
                                                                    <th>Minutes</th>
                                                                    <th>Rate Per Minute</th>
                                                                    <th>Earnings</th>
                                                                    <th>Time</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="customer-transactions-table-body"></tbody>
                                                        </table>
                                                    </div>
                                                    <hr class="divider" />
                                                    <div class="text-start p-2 m-2">
                                                        <div id="dateRangeEarningsResult"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Customer Withdrawal Info -->
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="card">
                                                <div id="customer-withdrawals-table-header"
                                                    class="card-header pb-1 card-no-border d-flex w-100 justify-content-between align-items-center mb-4">

                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="app-datatable-default overflow-auto">
                                                        <table class="display app-data-table default-data-table table"
                                                            id="customer-withdrawals-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Withdrawal Id</th>
                                                                    <th>Customer Id</th>
                                                                    <th>Withdrawal Method</th>
                                                                    <th>Withdrawal Amount</th>
                                                                    <th>Payout Details</th>
                                                                    <th>Status</th>
                                                                    <th>Created At</th>
                                                                    <th>Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="customer-withdrawals-table-body"></tbody>
                                                        </table>
                                                    </div>
                                                    <hr class="divider" />
                                                    <div class="text-start p-2 m-2">
                                                        <div id="dateRangeWithdrawalResult"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </main>
                        <div class="go-top">
                            <span class="progress-value">
                                <i class="ti ti-arrow-up"></i>
                            </span>
                        </div>
                </div>
            </div>
    </div>

    <!-- Edit Withdrawal Modal -->
    <div class="modal fade bd-example-modal-lg" id="editModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header bg-primary-900">
                    <h5 class="modal-title text-white">Edit Customer Withdrawal</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body dark-modal">

                    <form id="editCustomerWithdrawalForm" class="row g-3 custom-input">
                        <input type="hidden" id="editWithdrawalId" name="id">
                        <input type="hidden" id="editWithdrawalCustomerId" name="customerId">

                        <div class="col-12">
                            <label class="form-label">Withdrawal Method *</label>
                            <input type="text" id="editWithdrawalMethod" name="withdrawalMethod" class="form-control"
                                required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Withdrawal Amount *</label>
                            <input type="number" id="editWithdrawalAmount" name="withdrawalAmount" class="form-control"
                                min="1" required>
                        </div>

                        <div class="col-12">
                            <label for="kv-edit-container" class="form-label">Withdrawal Details *</label>
                            <div id="kv-edit-container">
                            </div>

                            <button type="button" id="addEditRow" class="btn btn-outline-primary btn-sm py-1"
                                data-target="#kv-edit-container">
                                <i class="ti ti-plus fs-5"></i>
                            </button>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold" for="editWithdrawalStatus">
                                Status <span class="text-danger">*</span>
                            </label>

                            <select class="form-select shadow-sm" name="status" id="editWithdrawalStatus" required>
                                <option selected disabled>Select Payment Status</option>
                                <option value="PENDING">🟡 Pending</option>
                                <option value="DONE">🟢 Done</option>
                                <option value="CANCELLED">🔴 Cancelled</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <button class="btn btn-primary" type="submit">Edit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Withdrawal Modal -->
    <div class="modal fade bd-example-modal-lg" id="addModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary-900">
                    <h5 class="modal-title text-white">Add Customer Withdrawal</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body dark-modal">
                    <form id="addCustomerWithdrawalForm" class="row g-3 custom-input">
                        <input type="number" id="addCustomerId" name="customerId" class="form-control"
                            placeholder="Customer Id" required hidden>

                        <div class="col-6">
                            <label class="form-label" for="addWithdrawalMethod">Withdrawal Method
                                *</label>
                            <input type="text" id="addWithdrawalMethod" name="withdrawalMethod" class="form-control"
                                placeholder="Withdrawal Method" required>
                        </div>

                        <div class="col-6">
                            <label class="form-label" for="addWithdrawalAmount">Withdrawal Amount
                                *</label>
                            <input type="number" id="addWithdrawalAmount" name="withdrawalAmount" class="form-control"
                                placeholder="Withdrawal Amount" min="1" required>
                        </div>

                        <div class="col-12">
                            <label for="kv-container" class="form-label">Withdrawal Details *</label>
                            <div id="kv-container">
                                <div class="row g-2 align-items-center kv-row mb-2">
                                    <div class="col-md-5">
                                        <input type="text" name="keys[]" class="form-control" placeholder="Key"
                                            required>
                                    </div>
                                    <div class="col-md-5">
                                        <input type="text" name="values[]" class="form-control" placeholder="Value"
                                            required>
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <button type="button" class="btn btn-danger btn-sm py-1 remove-row">
                                            <i class="ti ti-trash fs-5"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <button type="button" id="addRow" class="btn btn-outline-primary btn-sm py-1"
                                data-target="#kv-container">
                                <i class="ti ti-plus fs-5"></i>
                            </button>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold" for="addWithdrawalStatus">
                                Status <span class="text-danger">*</span>
                            </label>

                            <select class="form-select shadow-sm" name="status" id="addWithdrawalStatus" required>
                                <option selected disabled>Select Payment Status</option>
                                <option value="PENDING">🟡 Pending</option>
                                <option value="DONE">🟢 Done</option>
                                <option value="CANCELLED">🔴 Cancelled</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <button class="btn btn-primary" type="submit">Add</button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

    <%- include('partials/modals') %>
        <%- include('partials/jsFooter') %>
            <script src="/js/init/customerTransactionsInfoInit.js" type="module"></script>
</body>

</html>